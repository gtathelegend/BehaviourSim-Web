# BehaviorSim Website Environment Configuration
# Copy this file to .env.local for local development.

# Base URL for the BehaviorSim API
# Local dev default: http://localhost:8000
# Production: https://api.behavioursim.vedaangsharma.in
NEXT_PUBLIC_API_BASE_URL=https://api.behavioursim.vedaangsharma.in

# Public URL of the website
# Local dev default: http://localhost:3000
# Production: https://behavioursim.vedaangsharma.in
NEXT_PUBLIC_SITE_URL=https://behavioursim.vedaangsharma.in
